# macOS
.DS_Store
.AppleDouble
.LSOverride

# Workspace artifacts - runtime outputs
workspace/
*.json
*.html
*.xml
!cli/scripts/json/*.json

# Temporary files
tmp/
*.tmp
*.log
*.swp
*.bak
*~

# Environment files - NEVER commit credentials!
.env
.boomi-cli-config
**/secrets.sh
**/*credentials*
**/*password*
**/*token*.txt

# IDE
.vscode/
.idea/
*.iml
*.code-workspace

# OS
Thumbs.db
desktop.ini

# Test artifacts
test-results/
coverage/
*.test.json

# Build artifacts
dist/
build/

# SonarQube (download separately - see docs)
sonarqube/sonar-scanner/
sonarqube/*.zip

# test-env: the SonarQube quality profile is source (keep despite the *.xml ignore)
!test-env/sonarqube/boomi-quality-profile.xml

# Node modules (if using any JS tooling)
node_modules/
package-lock.json

# test-env: corporate proxy CAs are machine-specific, do not commit (keep dir via .gitkeep)
test-env/agent/certs/*.crt
!test-env/agent/certs/.gitkeep

# test-env: sonar-scanner zip is fetched at build time, not committed
test-env/agent/sonar-scanner.zip
