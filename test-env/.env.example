# Copy to test-env/.env and fill in. Consumed by agent/run-agent.sh.
# test-env/.env is gitignored — never commit real tokens.

# --- Azure DevOps (for the self-hosted agent) ---
# Org URL: either https://dev.azure.com/<org> or https://<org>.visualstudio.com
AZP_URL=https://anshumanpadhi.visualstudio.com
# PAT with scope: Agent Pools (Read & manage). Create at:
#   <org>/_usersSettings/tokens
AZP_TOKEN=replace-with-azure-devops-pat
# Agent pool name (create/confirm under Project Settings -> Agent pools)
AZP_POOL=Default
AZP_AGENT_NAME=boomi-podman-agent
