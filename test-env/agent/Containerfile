# Azure DevOps self-hosted agent for Apple Silicon / arm64, preloaded with the
# tooling the Boomi CICD CLI + SonarQube scan need.
#
# The agent binary itself is downloaded at RUNTIME by start.sh (it asks your org
# for the package matching the server version — the official Microsoft dockeragent
# pattern), so no agent version is baked in and it never goes stale.
#
# Build:  podman build --arch arm64 -t boomi-azdo-agent test-env/agent
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      jq \
      git \
      unzip \
      bash \
      libicu70 \
      libssl3 \
      openjdk-17-jre-headless \
      libxml2-utils \
    && rm -rf /var/lib/apt/lists/*

# Trust corporate/proxy root CAs (e.g. Zscaler) so in-container HTTPS works behind a
# TLS-intercepting proxy. Drop your root CA as test-env/agent/certs/*.crt (gitignored);
# this is a no-op if the dir only contains .gitkeep. Also point Node-based agent tasks
# at the merged bundle via NODE_EXTRA_CA_CERTS.
COPY certs/ /usr/local/share/ca-certificates/
RUN update-ca-certificates
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

# sonar-scanner CLI (generic build — uses the system JRE 17 above, so it is arm64-safe;
# the OS-specific bundles ship an x86_64 JRE that will not run on arm64).
# The zip is fetched on the HOST by run-agent.sh (reliable behind the corporate
# proxy) and copied in here, avoiding flaky in-container downloads through Zscaler.
ARG SONAR_SCANNER_VERSION=5.0.1.3006
COPY sonar-scanner.zip /tmp/sonar-scanner.zip
RUN unzip -q /tmp/sonar-scanner.zip -d /opt \
    && ln -s "/opt/sonar-scanner-${SONAR_SCANNER_VERSION}" /opt/sonar-scanner \
    && rm /tmp/sonar-scanner.zip
ENV PATH="/opt/sonar-scanner/bin:${PATH}"
# Arch-agnostic JAVA_HOME (works on amd64 AND arm64) via a stable symlink to the
# installed JRE — don't hardcode /usr/lib/jvm/java-17-openjdk-<arch>.
RUN ln -sfn "$(dirname "$(dirname "$(readlink -f "$(command -v java)")")")" /opt/java-home
ENV JAVA_HOME=/opt/java-home
# sonar-scanner 5.x must use the system JRE, not try to provision one
ENV SONAR_SCANNER_OPTS=""

# Semgrep — SAST for the Groovy/JS extracted from Boomi components. Installed via
# pip; point pip AND requests at the system CA bundle (which now trusts the proxy
# root CA) so install + any registry access work behind the TLS-intercepting proxy.
ENV PIP_CERT=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir semgrep \
    && semgrep --version

# Node.js — required by SonarQube's JavaScript/TypeScript analyzer (SonarJS) whenever
# a .js file is in scope (e.g. a JavaScript Boomi Data Process script). Installed from
# the official nodejs.org tarball (arch-agnostic; works behind the proxy via the CA above).
ARG NODE_VERSION=20.18.1
RUN arch="$(dpkg --print-architecture)"; case "$arch" in amd64) na=x64 ;; arm64) na=arm64 ;; *) na="$arch" ;; esac \
    && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${na}.tar.gz" -o /tmp/node.tar.gz \
    && tar -xzf /tmp/node.tar.gz -C /opt \
    && ln -sf "/opt/node-v${NODE_VERSION}-linux-${na}/bin/node" /usr/local/bin/node \
    && ln -sf "/opt/node-v${NODE_VERSION}-linux-${na}/bin/npm" /usr/local/bin/npm \
    && rm /tmp/node.tar.gz \
    && node -v

# The agent refuses to configure as root by default; run it as a dedicated user.
RUN useradd -m -s /bin/bash agent
WORKDIR /azp

# Pre-bake the Azure DevOps agent (fetched on the host by run-agent.sh) so the
# container skips the large runtime CDN download, which stalls behind the proxy.
# start.sh detects the baked agent (./config.sh) and only makes the small
# registration calls at runtime. Falls back to a hardened download if absent.
COPY azp-agent.tgz /tmp/azp-agent.tgz
RUN tar -xzf /tmp/azp-agent.tgz -C /azp && rm /tmp/azp-agent.tgz

COPY start.sh /azp/start.sh
RUN chmod +x /azp/start.sh && chown -R agent:agent /azp

USER agent
ENTRYPOINT ["/azp/start.sh"]
